@page "/createplaid"
@using System.Xml.Serialization
@using System.Drawing
@using System.Globalization
@using System.Drawing.Imaging
@using MudBlazor
@using SkiaSharp;
@inject HttpClient Http

<PageTitle>チェック柄作成</PageTitle>

<h2>チェック柄作成ツール</h2>

@if (formatDefines == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="container border">
        <div class="row">
            <div class="col-sm-3">
                サイズ：
            </div>
            <div class="col-sm-4">
                <select class="form-select form-select-sm" value="@selectId" @oninput="OnSelectFormat">
                    @foreach (var formatdefine in formatDefines.Defines)
                    {
                        <option value="@formatdefine.Id">@formatdefine.Id</option>
                    }
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-3">
                柄：
            </div>
            <div class="col-sm-5">
                <select class="form-select form-select-sm" value="@selectKind" @oninput="OnSelectKind">
                    @foreach (var kindString in kindList)
                    {
                        <option value="@kindString">@kindString</option>
                    }
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-3">
                チェック幅：
            </div>
            <div class="col-sm-3">
                <input class="form-control form-control-sm" type="number" value="@plaidsize" @onchange="OnChangePlaidSize" />
            </div>
        </div>
        <div class="row">
            <p></p>
        </div>
        <div class="row color1">
            <div class="col-sm-2">
                色1：
            </div>
            <div class="col-sm-3">
                <input class="form-control form-control-sm" type="text" value="@color1" @onchange="OnChangeColor1" maxlength="6" />
            </div>
            <div class="col-sm-3">
                <button type="button" class="btn btn-light" @onclick="OnColor1SelectArea">
                    色1選択
                </button>
            </div>
        </div>
        @if (@color1select)
        {
            <div class="row border">
                <div class="col-sm-3">
                    <MudSlider Style="color:red;" @bind-Value="@color1redvalue" Min="0" Max="255" @onchange="OnColor1Changed">Red:@color1redvalue</MudSlider>
                </div>
                <div class="col-sm-3">
                    <MudSlider Style="color:green;" @bind-Value="@color1greenvalue" Min="0" Max="255" @onchange="OnColor1Changed">Green:@color1greenvalue</MudSlider>
                </div>
                <div class="col-sm-3">
                    <MudSlider Style="color:blue;" @bind-Value="@color1bluevalue" Min="0" Max="255" @onchange="OnColor1Changed">Blue:@color1bluevalue</MudSlider>
                </div>
            </div>
        }
        <div class="row">
            <p></p>
        </div>
        <div class="row color2">
            <div class="col-sm-2">
                色2：
            </div>
            <div class="col-sm-3">
                <input class="form-control form-control-sm" type="text" value="@color2" @onchange="OnChangeColor2" maxlength="6" />
            </div>
            <div class="col-sm-3">
                <button type="button" class="btn btn-light" @onclick="OnColor2SelectArea">
                    色2選択
                </button>
            </div>
        </div>
        @if (@color2select)
        {
            <div class="row border">
                <div class="col-sm-3">
                    <MudSlider Style="color:red;" @bind-Value="@color2redvalue" Min="0" Max="255" @onchange="OnColor2Changed">Red:@color2redvalue</MudSlider>
                </div>
                <div class="col-sm-3">
                    <MudSlider Style="color:green;" @bind-Value="@color2greenvalue" Min="0" Max="255" @onchange="OnColor2Changed">Green:@color2greenvalue</MudSlider>
                </div>
                <div class="col-sm-3">
                    <MudSlider Style="color:blue;" @bind-Value="@color2bluevalue" Min="0" Max="255" @onchange="OnColor2Changed">Blue:@color2bluevalue</MudSlider>
                </div>
            </div>
        }
        <div class="row">
            <p></p>
        </div>
        <div class="row basecolor">
            <div class="col-sm-2">
                ベース色:
            </div>
            <div class="col-sm-3">
                <input class="form-control form-control-sm" type="text" value="@basecolor" @onchange="OnChangeBaseColor" maxlength="6" />
            </div>
            <div class="col-sm-4">
                <button type="button" class="btn btn-light" @onclick="OnBaseColorSelectArea">
                    ベース色選択
                </button>
            </div>
            <div class="col-sm-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="alpha" @bind-value="@checkalpha" />
                    <label class="form-check-label" for="alpha">透明</label>
                </div>
            </div>
        </div>
        @if (@basecolorselect)
        {
            <div class="row border">
                <div class="col-sm-3">
                    <MudSlider Style="color:red;" @bind-Value="@basecolorredvalue" Min="0" Max="255" @onchange="OnBaseColorChanged">Red:@basecolorredvalue</MudSlider>
                </div>
                <div class="col-sm-3">
                    <MudSlider Style="color:green;" @bind-Value="@basecolorgreenvalue" Min="0" Max="255" @onchange="OnBaseColorChanged">Green:@basecolorgreenvalue</MudSlider>
                </div>
                <div class="col-sm-3">
                    <MudSlider Style="color:blue;" @bind-Value="@basecolorbluevalue" Min="0" Max="255" @onchange="OnBaseColorChanged">Blue:@basecolorbluevalue</MudSlider>
                </div>
            </div>
        }
        <div class="row">
            <p></p>
        </div>
        <div class="row">
            <div class="col-sm-4">
                <button class="btn btn-secondary" @onclick="GetColor_Button">色ランダム1</button>
            </div>
            <div class="col-sm-4">
                <button class="btn btn-secondary" @onclick="GetColor2_Button">色ランダム2</button>
            </div>
        </div>
        <div class="row">
            <p></p>
        </div>
        <div class="row">
            <div class="col-sm-3">
                <button class="btn btn-primary" @onclick="OnButtonClick" disabled="@validBtn">画像生成</button>
            </div>
        </div>
        <div class="row">
            <p></p>
        </div>
    </div>

    <br />
    @if (drawImage)
    {
        <div class="container border">
            <img src="@imgSource" style="width:50%;height:50%;" />
        </div>
    }
}

<style>
    :root {
        --bg-color1: @bgcolor1;
        --bg-color2: @bgcolor2;
        --bg-basecolor: @bgbasecolor;
    }

    div.color1 {
        background-color: var(--bg-color1);
    }
    .color2 {
        background-color: var(--bg-color2);
    }

    .basecolor {
        background-color: var(--bg-basecolor);
    }
</style>

@code {
    private Models.FormatDefines formatDefines;
    private string selectId = string.Empty;
    private List<string> kindList = new List<string>();
    private string selectKind = string.Empty;
    private string color1 = "FFFFFF";
    private string color2 = "FFFFFF";
    private string basecolor = "FFFFFF";
    private string bgcolor1 = "#FFFFFF";
    private string bgcolor2 = "#FFFFFF";
    private string bgbasecolor = "#FFFFFF";
    private string plaidsize = "100";
    private bool color1select = false;
    private int color1redvalue = 255;
    private int color1greenvalue = 255;
    private int color1bluevalue = 255;
    private bool color2select = false;
    private int color2redvalue = 255;
    private int color2greenvalue = 255;
    private int color2bluevalue = 255;
    private bool basecolorselect = false;
    private bool checkalpha = false;
    private int basecolorredvalue = 255;
    private int basecolorgreenvalue = 255;
    private int basecolorbluevalue = 255;
    private bool validBtn = false;
    private string str = string.Empty;
    private int fileWidth;
    private int fileHeight;
    private SKBitmap bitmap;
    private string imgSource;
    private bool drawImage = false;
    private string? xmlText;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(50);

        //ファイルサイズフォーマット読み込み
        xmlText = await Http.GetStringAsync("formatlist.xml");
        XmlSerializer serializer = new XmlSerializer(typeof(Models.FormatDefines));
        formatDefines = (Models.FormatDefines)serializer.Deserialize(new StringReader(xmlText));
        if (formatDefines != null)
        {
            selectId = formatDefines.Defines[0].Id;
            fileWidth = formatDefines.Defines[0].Width;
            fileHeight = formatDefines.Defines[0].Height;
        }

        //チェック柄選択リスト
        var kindLists = new string[] {
            "RandomCheck",
            "RandomCheck1",
            "RandomCheck2",
            "RandomCheck3",
            "RandomCheck4",
            "RandomCheck5",
            "Check2Line",
            "GinghamCheck1",
            "GinghamCheck2",
            "GinghamCheck3",
            "Check1",
            "Check1_2",
            "Check2",
            "Check3",
            "Check4",
            "Checkered1",
            "Checkered2",
            "TartanCheck1",
            "TartanCheck2",
            "TartanCheck3",
            "TartanCheck4",
            "TartanCheck5",
            "VerticalLine1",
            "HorizontalLine1",
            "PolkaDot1"
        };
        kindList.AddRange(kindLists.ToList());
        selectKind = kindList[0];
    }

    private void OnButtonClick(MouseEventArgs e)
    {
        //チェック柄モデル作成
        PlaidModel model = new PlaidModel();
        model.KindPlaid = selectKind;
        model.BaseAlpha = 255;
        model.BaseBalance = 2;
        //色設定
        byte color1r = byte.Parse(color1.Substring(0, 2), NumberStyles.HexNumber);
        byte color1g = byte.Parse(color1.Substring(2, 2), NumberStyles.HexNumber);
        byte color1b = byte.Parse(color1.Substring(4, 2), NumberStyles.HexNumber);
        byte color2r = byte.Parse(color2.Substring(0, 2), NumberStyles.HexNumber);
        byte color2g = byte.Parse(color2.Substring(2, 2), NumberStyles.HexNumber);
        byte color2b = byte.Parse(color2.Substring(4, 2), NumberStyles.HexNumber);
        model.VerticalColorRed1 = color1r;
        model.VerticalColorGreen1 = color1g;
        model.VerticalColorBlue1 = color1b;
        model.VerticalSize1 = int.Parse(plaidsize);
        model.HorizontalColorRed1 = color1r;
        model.HorizontalColorGreen1 = color1g;
        model.HorizontalColorBlue1 = color1b;
        model.HorizontalSize1 = int.Parse(plaidsize);
        model.VerticalColorRed2 = color2r;
        model.VerticalColorGreen2 = color2g;
        model.VerticalColorBlue2 = color2b;
        model.VerticalSize2 = int.Parse(plaidsize);
        model.HorizontalColorRed2 = color2r;
        model.HorizontalColorGreen2 = color2g;
        model.HorizontalColorBlue2 = color2b;
        model.BaseColorRed = byte.Parse(basecolor.Substring(0, 2), NumberStyles.HexNumber);
        model.BaseColorGreen = byte.Parse(basecolor.Substring(2, 2), NumberStyles.HexNumber);
        model.BaseColorBlue = byte.Parse(basecolor.Substring(4, 2), NumberStyles.HexNumber);
        if (this.checkalpha)
        {
            model.BaseAlpha = 0;
        }
        else
        {
            model.BaseAlpha = 255;
        }

        //イメージ作成
        bitmap = BussinessLogic.NewCreateImage(fileWidth, fileHeight);
        bitmap = BussinessLogic.EditImage(bitmap, model);

        using var image = SKImage.FromBitmap(bitmap);
        using var data = image.Encode(SKEncodedImageFormat.Png, 100);
        byte[] pngBytes = data.ToArray();
        imgSource = $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
        drawImage = true;
    }

    private void OnSelectFormat(ChangeEventArgs e)
    {
        if (e.Value == null) return;
        selectId = e.Value.ToString();
        var selectDefine = formatDefines.Defines.FirstOrDefault(x => x.Id == selectId);
        if (selectDefine == null) return;
        fileWidth = selectDefine.Width;
        fileHeight = selectDefine.Height;
    }

    private void OnSelectKind(ChangeEventArgs e)
    {
        if (e.Value == null) return;
        selectKind = e.Value.ToString();
    }

    private void OnChangeColor1(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }
        else
        {
            color1 = e.Value.ToString();
            if (color1.Length == 6)
            {
                bgcolor1 = "#" + color1;
                color1redvalue = byte.Parse(color1.Substring(0, 2), NumberStyles.HexNumber);
                color1greenvalue = byte.Parse(color1.Substring(2, 2), NumberStyles.HexNumber);
                color1bluevalue = byte.Parse(color1.Substring(4, 2), NumberStyles.HexNumber);
            }

            validateImageButton();
        }
    }

    private void OnChangeColor2(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }
        else
        {
            color2 = e.Value.ToString();
            if (color2.Length == 6)
            {
                bgcolor2 = "#" + color2;
                color2redvalue = byte.Parse(color2.Substring(0, 2), NumberStyles.HexNumber);
                color2greenvalue = byte.Parse(color2.Substring(2, 2), NumberStyles.HexNumber);
                color2bluevalue = byte.Parse(color2.Substring(4, 2), NumberStyles.HexNumber);
            }

            validateImageButton();
        }
    }

    private void OnChangeBaseColor(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }
        else
        {
            basecolor = e.Value.ToString();
            if (basecolor.Length == 6)
            {
                bgbasecolor = "#" + basecolor;
                basecolorredvalue = byte.Parse(basecolor.Substring(0, 2), NumberStyles.HexNumber);
                basecolorgreenvalue = byte.Parse(basecolor.Substring(2, 2), NumberStyles.HexNumber);
                basecolorbluevalue = byte.Parse(basecolor.Substring(4, 2), NumberStyles.HexNumber);
            }

            validateImageButton();
        }
    }

    private void OnChangePlaidSize(ChangeEventArgs e)
    {
        if (e.Value == null) return;
        plaidsize = e.Value.ToString();
    }

    private void GetColor_Button(MouseEventArgs e)
    {
        string getColor1 = BussinessLogic.GetColor();
        color1 = getColor1;
        bgcolor1 = "#" + color1;
        color1redvalue = byte.Parse(color1.Substring(0, 2), NumberStyles.HexNumber);
        color1greenvalue = byte.Parse(color1.Substring(2, 2), NumberStyles.HexNumber);
        color1bluevalue = byte.Parse(color1.Substring(4, 2), NumberStyles.HexNumber);
        string getColor2 = BussinessLogic.GetColor();
        color2 = getColor2;
        bgcolor2 = "#" + color2;
        color2redvalue = byte.Parse(color2.Substring(0, 2), NumberStyles.HexNumber);
        color2greenvalue = byte.Parse(color2.Substring(2, 2), NumberStyles.HexNumber);
        color2bluevalue = byte.Parse(color2.Substring(4, 2), NumberStyles.HexNumber);
    }

    private void GetColor2_Button(MouseEventArgs e)
    {
        string getColor1 = BussinessLogic.GetColor2();
        color1 = getColor1;
        bgcolor1 = "#" + color1;
        color1redvalue = byte.Parse(color1.Substring(0, 2), NumberStyles.HexNumber);
        color1greenvalue = byte.Parse(color1.Substring(2, 2), NumberStyles.HexNumber);
        color1bluevalue = byte.Parse(color1.Substring(4, 2), NumberStyles.HexNumber);
        string getColor2 = BussinessLogic.GetColor2();
        color2 = getColor2;
        bgcolor2 = "#" + color2;
        color2redvalue = byte.Parse(color2.Substring(0, 2), NumberStyles.HexNumber);
        color2greenvalue = byte.Parse(color2.Substring(2, 2), NumberStyles.HexNumber);
        color2bluevalue = byte.Parse(color2.Substring(4, 2), NumberStyles.HexNumber);
    }

    private void OnColor1SelectArea()
    {
        color1select = !color1select;
    }

    private void OnColor1Changed()
    {
        color1 = string.Format("{0:X2}{1:X2}{2:X2}", color1redvalue, color1greenvalue, color1bluevalue);
        bgcolor1 = "#" + color1;
    }
    
    private void OnColor2SelectArea()
    {
        color2select = !color2select;
    }

    private void OnColor2Changed()
    {
        color2 = string.Format("{0:X2}{1:X2}{2:X2}", color2redvalue, color2greenvalue, color2bluevalue);
        bgcolor2 = "#" + color2;
    }

    private void OnBaseColorSelectArea()
    {
        basecolorselect = !basecolorselect;
    }

    private void OnBaseColorChanged()
    {
        basecolor = string.Format("{0:X2}{1:X2}{2:X2}", basecolorredvalue, basecolorgreenvalue, basecolorbluevalue);
        bgbasecolor = "#" + basecolor;
    }

    private void validateImageButton()
    {
        if (color1.Length == 6 && color2.Length == 6 && basecolor.Length == 6)
        {
            validBtn = false;
        }
        else
        {
            validBtn = true;
        }
    }
}
