@page "/createscenery"
@using System.Xml.Serialization
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using SkiaSharp;
@inject HttpClient Http

<PageTitle>背景作成</PageTitle>

<h2>背景作成ツール</h2>

@if (formatDefines == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (procLoading)
    {
        <div class="overlay">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">処理中...</span>
            </div>
        </div>
    }
    <div class="container border">
        <div class="row">
            <div class="col-sm-3">
                サイズ：
            </div>
            <div class="col-sm-4">
                <select class="form-select form-select-sm" value="@selectId" @oninput="OnSelectFormat">
                    @foreach (var formatdefine in formatDefines.Defines)
                    {
                        <option value="@formatdefine.Id">@formatdefine.Id</option>
                    }
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-3">
                柄：
            </div>
            <div class="col-sm-5">
                <select class="form-select form-select-sm" value="@selectKind" @oninput="OnSelectKind">
                    @foreach (var kindString in kindList)
                    {
                        <option value="@kindString">@kindString</option>
                    }
                </select>
            </div>
        </div>
        @if (!enabledStainedGlass)
        {
            @if (enableBlock)
            {
                <div class="row">
                    <div class="col-sm-3">
                        ブロック幅：
                    </div>
                    <div class="col-sm-3">
                        <input class="form-control form-control-sm" type="number" value="@scenerysize" @onchange="OnChangePlaidSize" />
                    </div>
                </div>
            }
            <div class="row">
                <p></p>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <button class="btn btn-secondary" @onclick="GetColor_Button">色ランダム1</button>
                </div>
                <div class="col-sm-4">
                    <button class="btn btn-secondary" @onclick="GetColor2_Button">色ランダム2</button>
                </div>
            </div>
            <div class="row">
                <p></p>
            </div>
            <div class="row color1">
                <div class="col-sm-3" style="padding-top:5px;">
                    色1：
                </div>
                <div class="col-sm-3" style="padding-top:3px;">
                    <input class="form-control form-control-sm" type="text" value="@color1" @onchange="OnChangeColor1" maxlength="6" />
                </div>
                <div class="col-sm-3">
                    <button type="button" class="btn btn-light" @onclick="OnColor1SelectArea">
                        色1選択
                    </button>
                </div>
            </div>
            @if (@color1select)
            {
                <div class="row border color1">
                    <div class="col-sm-3">
                        <MudSlider Style="color:red;" @bind-value="@color1redvalue" Min="0" Max="255" @onchange="OnColor1Changed">Red:@color1redvalue</MudSlider>
                    </div>
                    <div class="col-sm-3">
                        <MudSlider Style="color:green;" @bind-Value="@color1greenvalue" Min="0" Max="255" @onchange="OnColor1Changed">Green:@color1greenvalue</MudSlider>
                    </div>
                    <div class="col-sm-3">
                        <MudSlider Style="color:blue;" @bind-Value="@color1bluevalue" Min="0" Max="255" @onchange="OnColor1Changed">Blue:@color1bluevalue</MudSlider>
                    </div>
                </div>
            }
            <div class="row">
                <p></p>
            </div>
            <div class="row color2">
                <div class="col-sm-3" style="padding-top:5px;">
                    色2：
                </div>
                <div class="col-sm-3" style="padding-top:3px;">
                    <input class="form-control form-control-sm" type="text" value="@color2" @onchange="OnChangeColor2" maxlength="6" />
                </div>
                <div class="col-sm-3">
                    <button type="button" class="btn btn-light" @onclick="OnColor2SelectArea">
                        色2選択
                    </button>
                </div>
            </div>
            @if (@color2select)
            {
                <div class="row border color2">
                    <div class="col-sm-3">
                        <MudSlider Style="color:red;" @bind-Value="@color2redvalue" Min="0" Max="255" @onchange="OnColor2Changed">Red:@color2redvalue</MudSlider>
                    </div>
                    <div class="col-sm-3">
                        <MudSlider Style="color:green;" @bind-Value="@color2greenvalue" Min="0" Max="255" @onchange="OnColor2Changed">Green:@color2greenvalue</MudSlider>
                    </div>
                    <div class="col-sm-3">
                        <MudSlider Style="color:blue;" @bind-Value="@color2bluevalue" Min="0" Max="255" @onchange="OnColor2Changed">Blue:@color2bluevalue</MudSlider>
                    </div>
                </div>
            }
            <div class="row">
                <p></p>
            </div>
            <div class="row basecolor">
                <div class="col-sm-3" style="padding-top:5px;">
                    ベース色:
                </div>
                <div class="col-sm-3" style="padding-top:3px;">
                    <input class="form-control form-control-sm" type="text" value="@basecolor" @onchange="OnChangeBaseColor" maxlength="6" disabled="@checkalpha" />
                </div>
                <div class="col-sm-4">
                    <button type="button" class="btn btn-light" @onclick="OnBaseColorSelectArea">
                        ベース色選択
                    </button>
                </div>
                <div class="col-sm-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="alpha" @bind-value="@checkalpha" />
                        <label class="form-check-label" for="alpha">ベース色透明</label>
                    </div>
                </div>
            </div>
            @if (@basecolorselect)
            {
                <div class="row border basecolor">
                    <div class="col-sm-3">
                        <MudSlider Style="color:red;" @bind-Value="@basecolorredvalue" Min="0" Max="255" @onchange="OnBaseColorChanged">Red:@basecolorredvalue</MudSlider>
                    </div>
                    <div class="col-sm-3">
                        <MudSlider Style="color:green;" @bind-Value="@basecolorgreenvalue" Min="0" Max="255" @onchange="OnBaseColorChanged">Green:@basecolorgreenvalue</MudSlider>
                    </div>
                    <div class="col-sm-3">
                        <MudSlider Style="color:blue;" @bind-Value="@basecolorbluevalue" Min="0" Max="255" @onchange="OnBaseColorChanged">Blue:@basecolorbluevalue</MudSlider>
                    </div>
                </div>
                <div class="row">
                    <p></p>
                </div>
            }
            <div class="row">
                <p></p>
            </div>
        }
        @if (enabledStainedGlass)
        {
            <div class="row border">
                <div class="col-sm-5">
                    <MudSlider @bind-Value="@saturationValue" Min="0" Max="100">彩度:@saturationValue</MudSlider>
                </div>
            </div>
        }
        @if (enabledDotted)
        {
            <div class="row border">
                <div class="col-sm-5">
                    <MudSlider @bind-Value="@vlineWeightSize" Min="1" Max="5">線の太さ（水平）:@vlineWeightSize</MudSlider>
                </div>
                <div class="col-sm-5">
                    <MudSlider @bind-Value="@hlineWeightSize" Min="1" Max="5">線の太さ（垂直）:@hlineWeightSize</MudSlider>
                </div>
            </div>
            <div class="row border">
                <div class="col-sm-5">
                    <InputRadioGroup Name="hdotpattern" @bind-Value="@hDottedPattern">
                        <label>点線種類（水平）:</label>
                        @foreach (var val in Enum.GetValues(typeof(hDottedValue)))
                        {
                            <label style="margin-left:5px;"><InputRadio Value="val" />@val</label>
                        }
                    </InputRadioGroup>
                </div>
                <div class="col-sm-5">
                    <InputRadioGroup Name="vdotpattern" @bind-Value="@vDottedPattern">
                        <label>点線種類（垂直）:</label>
                        @foreach (var val in Enum.GetValues(typeof(vDottedValue)))
                        {
                            <label style="margin-left:5px;"><InputRadio Value="val" />@val</label>
                        }
                    </InputRadioGroup>
                </div>
            </div>
            <div class="row">
                <p></p>
            </div>
        }
        @if (enabledStep)
        {
            <div class="row">
                <div class="col-sm-3">
                    方向：
                </div>
                <div class="col-sm-5">
                    <select class="form-select form-select-sm" value="@selectStepDirection" @oninput="OnSelectStepPattern">
                        <option value="right">右</option>
                        <option value="bottom">下</option>
                        <option value="rightBottom">右下</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-5">
                    <InputRadioGroup Name="stepcolorpattern" @bind-Value="@stepColorPattern">
                        <label>色パターン:</label>
                        @foreach (var val in Enum.GetValues(typeof(stepColorPatternValue)))
                        {
                            <label style="margin-left:5px;"><InputRadio Value="val" />@val</label>
                        }
                    </InputRadioGroup>
                    </div>
                </div>
            <div class="row">
                <p></p>
            </div>
        }
        @if (enabledShapeCount)
        {
            <div class="row border">
                <div class="col-sm-5">
                    <MudSlider @bind-Value="@shapeCount" Min="10" Max="1000">図形個数:@shapeCount</MudSlider>
                </div>
            </div>
            <div class="row border">
                <div class="col-sm-4">
                    最小サイズ：<input class="form-control form-control-sm" type="number" value="@shapeMinSize" @onchange="OnChangeShapeMinSize" />
                </div>
            </div>
        }
        @if (enabledStarCount)
        {
            <div class="row border">
                <div class="col-sm-5">
                    <MudSlider @bind-Value="@largeStarCount" Min="0" Max="500">大きい星の数:@largeStarCount</MudSlider>
                </div>
            </div>
            <div class="row border">
                <div class="col-sm-5">
                    <MudSlider @bind-Value="@smallStarCount" Min="0" Max="3000">小さい星の数:@smallStarCount</MudSlider>
                </div>
            </div>
            <div class="row border">
                <div class="col-sm-5">
                    <MudSlider @bind-Value="@sparkleCount" Min="0" Max="400">スパークルの数:@sparkleCount</MudSlider>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-sm-3">
                <button class="btn btn-primary" @onclick="OnButtonClick" disabled="@validBtn">画像生成</button>
            </div>
        </div>
        <div class="row">
            <p></p>
        </div>
    </div>

    <br />
    @if (drawImage)
    {
        <div class="container border">
            <img src="@imgSource" style="width:50%;height:50%;" />
        </div>
    }
}

<style>
    :root {
        --bg-color1: @bgcolor1;
        --bg-color2: @bgcolor2;
        --bg-basecolor: @bgbasecolor;
    }

    div.color1 {
        background-color: var(--bg-color1);
    }
    .color2 {
        background-color: var(--bg-color2);
    }

    .basecolor {
        background-color: var(--bg-basecolor);
    }

    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* 半透明の黒 */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999; /* 最前面に表示 */
    }
</style>

@code {
    private Models.FormatDefines formatDefines;
    private bool procLoading = false;
    private string selectId = string.Empty;
    private List<string> kindList = new List<string>();
    private string selectKind = string.Empty;
    private string color1 = "FFFFFF";
    private string color2 = "FFFFFF";
    private string basecolor = "FFFFFF";
    private string bgcolor1 = "#FFFFFF";
    private string bgcolor2 = "#FFFFFF";
    private string bgbasecolor = "#FFFFFF";
    private string scenerysize = "200";
    private bool color1select = false;
    private int color1redvalue = 255;
    private int color1greenvalue = 255;
    private int color1bluevalue = 255;
    private bool color2select = false;
    private int color2redvalue = 255;
    private int color2greenvalue = 255;
    private int color2bluevalue = 255;
    private bool basecolorselect = false;
    private bool checkalpha = false;
    private int basecolorredvalue = 255;
    private int basecolorgreenvalue = 255;
    private int basecolorbluevalue = 255;
    private bool validBtn = false;
    private bool enabledDotted = false;
    private int vlineWeightSize = 2;
    private int hlineWeightSize = 2;
    private vDottedValue? vDottedPattern { get; set; } = vDottedValue.one;
    private hDottedValue? hDottedPattern { get; set; } = hDottedValue.one;
    private bool enabledStep = false;
    private string selectStepDirection = string.Empty;
    private stepColorPatternValue? stepColorPattern { get; set; } = stepColorPatternValue.one;
    private string str = string.Empty;
    private int fileWidth;
    private int fileHeight;
    private SKBitmap bitmap;
    private string imgSource;
    private bool drawImage = false;
    private bool enableBlock = true;
    private bool enabledStainedGlass = false;
    private float hueValue = 0;
    private float saturationValue = 20;
    private bool enabledShapeCount = false;
    private int shapeCount = 80;
    private string shapeMinSize = "20";
    private bool enabledStarCount = false;
    private int largeStarCount = 30;
    private int smallStarCount = 250;
    private int sparkleCount = 20;

    public enum vDottedValue { one, two, three }
    public enum hDottedValue { one, two, three }
    public enum stepColorPatternValue { one, two, alt }
    private string? xmlText;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(50);

        //ファイルサイズフォーマット読み込み
        xmlText = await Http.GetStringAsync("formatlist.xml");
        XmlSerializer serializer = new XmlSerializer(typeof(Models.FormatDefines));
        formatDefines = (Models.FormatDefines)serializer.Deserialize(new StringReader(xmlText));
        if (formatDefines != null)
        {
            selectId = formatDefines.Defines[0].Id;
            fileWidth = formatDefines.Defines[0].Width;
            fileHeight = formatDefines.Defines[0].Height;
        }

        //背景選択リスト
        var kindLists = new string[] { "RandomShape", "RandomShape2", "RandomShapeMusic", "RandomStarrySky", "RandomStarrySky2", "DottedLine", "DottedLine2", "DottedLineRandom", "StepCircle", "StepSquare", "StainedGlass", "StainedGlass2", "Puzzle", "None" };
        kindList.AddRange(kindLists.ToList());
        selectKind = kindList[0];

        // フォント読み込み
        byte[] fontBytes = await Http.GetByteArrayAsync("fonts/NotoMusic-Regular.ttf");
        using var stream = new MemoryStream(fontBytes);
        SKTypeface typeface = SKTypeface.FromStream(stream);
        BussinessLogic.SetMusicTypeface(typeface);
    }

    private async Task OnButtonClick(MouseEventArgs e)
    {
        procLoading = true;
        drawImage = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);

        try
        {
            //背景モデル作成
            SceneryModel model = new SceneryModel();
            model.KindScenery = selectKind;
            model.Alpha = 255;
            model.BaseBalance = 2;
            //色設定
            byte color1r = byte.Parse(color1.Substring(0, 2), NumberStyles.HexNumber);
            byte color1g = byte.Parse(color1.Substring(2, 2), NumberStyles.HexNumber);
            byte color1b = byte.Parse(color1.Substring(4, 2), NumberStyles.HexNumber);
            byte color2r = byte.Parse(color2.Substring(0, 2), NumberStyles.HexNumber);
            byte color2g = byte.Parse(color2.Substring(2, 2), NumberStyles.HexNumber);
            byte color2b = byte.Parse(color2.Substring(4, 2), NumberStyles.HexNumber);
            model.VerticalColorRed1 = color1r;
            model.VerticalColorGreen1 = color1g;
            model.VerticalColorBlue1 = color1b;
            model.VerticalSize1 = int.Parse(scenerysize);
            model.HorizontalColorRed1 = color1r;
            model.HorizontalColorGreen1 = color1g;
            model.HorizontalColorBlue1 = color1b;
            model.HorizontalSize1 = int.Parse(scenerysize);
            model.VerticalColorRed2 = color2r;
            model.VerticalColorGreen2 = color2g;
            model.VerticalColorBlue2 = color2b;
            model.VerticalSize2 = int.Parse(scenerysize);
            model.HorizontalColorRed2 = color2r;
            model.HorizontalColorGreen2 = color2g;
            model.HorizontalColorBlue2 = color2b;
            model.BaseColorRed = byte.Parse(basecolor.Substring(0, 2), NumberStyles.HexNumber);
            model.BaseColorGreen = byte.Parse(basecolor.Substring(2, 2), NumberStyles.HexNumber);
            model.BaseColorBlue = byte.Parse(basecolor.Substring(4, 2), NumberStyles.HexNumber);
            if (this.checkalpha)
            {
                model.BaseAlpha = 0;
            }
            else
            {
                model.BaseAlpha = 255;
            }

            model.VerticalDottedWeight = vlineWeightSize;
            model.HorizontalDottedWeight = hlineWeightSize;
            model.VerticalDottedPattern = vDottedPattern.Value.ToString();
            model.HorizontalDottedPattern = hDottedPattern.Value.ToString();

            model.StepPattern = selectStepDirection;
            model.StepColorPattern = stepColorPattern.Value.ToString();

            model.HueValue = hueValue;
            model.SaturationValue = saturationValue / 100;

            model.ShapeCount = shapeCount;
            model.ShapeMinSize = int.Parse(shapeMinSize);

            model.LargeStarCount = largeStarCount;
            model.SmallStarCount = smallStarCount;
            model.SparkleCount = sparkleCount;

            //イメージ作成
            bitmap = BussinessLogic.NewCreateImage(fileWidth, fileHeight);
            bitmap = BussinessLogic.EditImage(bitmap, model);

            using var image = SKImage.FromBitmap(bitmap);
            using var data = image.Encode(SKEncodedImageFormat.Png, 100);
            byte[] pngBytes = data.ToArray();
            imgSource = $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
            drawImage = true;
        }
        finally
        {
            procLoading = false;
        }
    }

    private void OnSelectFormat(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }
        else
        {
            selectId = e.Value.ToString();
            var selectDefine = formatDefines.Defines.FirstOrDefault(x => x.Id == selectId);
            if (selectDefine == null) return;
            fileWidth = selectDefine.Width;
            fileHeight = selectDefine.Height;
        }
    }

    private void OnSelectKind(ChangeEventArgs e)
    {
        if (e.Value == null) {
            return;
        }
        else
        {
            selectKind = e.Value.ToString();
            enableBlock = true;
            enabledShapeCount = false;
            enabledStarCount = false;
            if (selectKind.Contains("StainedGlass"))
            {
                enabledStainedGlass = true;
                enabledDotted = false;
                enabledStep = false;
            }
            else
            {
                enabledStainedGlass = false;
                if (selectKind.Contains("Dotted"))
                {
                    enabledDotted = true;
                    enabledStep = false;
                }
                else if (selectKind.Contains("Step"))
                {
                    enabledDotted = false;
                    enabledStep = true;
                }
                else
                {
                    enabledDotted = false;
                    enabledStep = false;
                    if (selectKind == "RandomShape2") { enabledShapeCount = true;}
                    if (selectKind == "RandomShapeMusic") { enabledShapeCount = true;}
                    if (selectKind == "RandomStarrySky") { enabledStarCount = true; enableBlock = false; }
                    if (selectKind == "RandomStarrySky2") { enabledStarCount = true; enableBlock = false; }
                }
            }
        }
    }

    private void OnSelectStepPattern(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }
        else
        {
            selectStepDirection = e.Value.ToString();
        }
    }

    private void OnChangeColor1(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }
        else
        {
            color1 = e.Value.ToString();
            if (color1.Length == 6)
            {
                bgcolor1 = "#" + color1;
                color1redvalue = byte.Parse(color1.Substring(0, 2), NumberStyles.HexNumber);
                color1greenvalue = byte.Parse(color1.Substring(2, 2), NumberStyles.HexNumber);
                color1bluevalue = byte.Parse(color1.Substring(4, 2), NumberStyles.HexNumber);
            }

            validateImageButton();
        }
    }

    private void OnChangeColor2(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }
        else
        {
            color2 = e.Value.ToString();
            if (color2.Length == 6)
            {
                bgcolor2 = "#" + color2;
                color2redvalue = byte.Parse(color2.Substring(0, 2), NumberStyles.HexNumber);
                color2greenvalue = byte.Parse(color2.Substring(2, 2), NumberStyles.HexNumber);
                color2bluevalue = byte.Parse(color2.Substring(4, 2), NumberStyles.HexNumber);
            }

            validateImageButton();
        }
    }

    private void OnChangeBaseColor(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }
        else
        {
            basecolor = e.Value.ToString();
            if (basecolor.Length == 6)
            {
                bgbasecolor = "#" + basecolor;
                basecolorredvalue = byte.Parse(basecolor.Substring(0, 2), NumberStyles.HexNumber);
                basecolorgreenvalue = byte.Parse(basecolor.Substring(2, 2), NumberStyles.HexNumber);
                basecolorbluevalue = byte.Parse(basecolor.Substring(4, 2), NumberStyles.HexNumber);
            }

            validateImageButton();
        }
    }

    private void OnChangePlaidSize(ChangeEventArgs e)
    {
        if (e.Value == null) return;
        scenerysize = e.Value.ToString();
    }

    private void OnChangeShapeMinSize(ChangeEventArgs e)
    {
        if (e.Value == null) return;
        shapeMinSize = e.Value.ToString();
    }

    private void GetColor_Button(MouseEventArgs e)
    {
        string getColor1 = BussinessLogic.GetColor();
        color1 = getColor1;
        bgcolor1 = "#" + color1;
        color1redvalue = byte.Parse(color1.Substring(0, 2), NumberStyles.HexNumber);
        color1greenvalue = byte.Parse(color1.Substring(2, 2), NumberStyles.HexNumber);
        color1bluevalue = byte.Parse(color1.Substring(4, 2), NumberStyles.HexNumber);
        string getColor2 = BussinessLogic.GetColor();
        color2 = getColor2;
        bgcolor2 = "#" + color2;
        color2redvalue = byte.Parse(color2.Substring(0, 2), NumberStyles.HexNumber);
        color2greenvalue = byte.Parse(color2.Substring(2, 2), NumberStyles.HexNumber);
        color2bluevalue = byte.Parse(color2.Substring(4, 2), NumberStyles.HexNumber);
    }

    private void GetColor2_Button(MouseEventArgs e)
    {
        string getColor1 = BussinessLogic.GetColor2();
        color1 = getColor1;
        bgcolor1 = "#" + color1;
        color1redvalue = byte.Parse(color1.Substring(0, 2), NumberStyles.HexNumber);
        color1greenvalue = byte.Parse(color1.Substring(2, 2), NumberStyles.HexNumber);
        color1bluevalue = byte.Parse(color1.Substring(4, 2), NumberStyles.HexNumber);
        string getColor2 = BussinessLogic.GetColor2();
        color2 = getColor2;
        bgcolor2 = "#" + color2;
        color2redvalue = byte.Parse(color2.Substring(0, 2), NumberStyles.HexNumber);
        color2greenvalue = byte.Parse(color2.Substring(2, 2), NumberStyles.HexNumber);
        color2bluevalue = byte.Parse(color2.Substring(4, 2), NumberStyles.HexNumber);
    }

    private void OnColor1SelectArea()
    {
        color1select = !color1select;
    }

    private void OnColor1Changed()
    {
        color1 = string.Format("{0:X2}{1:X2}{2:X2}", color1redvalue, color1greenvalue, color1bluevalue);
        bgcolor1 = "#" + color1;
    }
    
    private void OnColor2SelectArea()
    {
        color2select = !color2select;
    }

    private void OnColor2Changed()
    {
        color2 = string.Format("{0:X2}{1:X2}{2:X2}", color2redvalue, color2greenvalue, color2bluevalue);
        bgcolor2 = "#" + color2;
    }

    private void OnBaseColorSelectArea()
    {
        basecolorselect = !basecolorselect;
    }

    private void OnBaseColorChanged()
    {
        basecolor = string.Format("{0:X2}{1:X2}{2:X2}", basecolorredvalue, basecolorgreenvalue, basecolorbluevalue);
        bgbasecolor = "#" + basecolor;
    }

    private void validateImageButton()
    {
        if (color1.Length == 6 && color2.Length == 6 && basecolor.Length == 6)
        {
            validBtn = false;
        }
        else
        {
            validBtn = true;
        }
    }
}
